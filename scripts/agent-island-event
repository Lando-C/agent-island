#!/usr/bin/env bash
# Copyright (c) 2026 Ling
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  agent-island-event <codex|claude> <app|cli> <working|needs_attention|queued|done|error|online|idle|offline> [title] [message]

Examples:
  agent-island-event codex cli working "Refactor auth" "running tests"
  agent-island-event codex cli done "Refactor auth" "tests passed"
  agent-island-event claude cli needs_attention "Permission" "waiting for approval"
  agent-island-event claude cli error "Batch job" "remote command failed"
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 3 ]]; then
  usage
  exit 1
fi

agent="$1"
surface="$2"
phase="$3"
title="${4:-}"
message="${5:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python3 - "$SCRIPT_DIR" "$agent" "$surface" "$phase" "$title" "$message" <<'PY'
import json
import os
import pathlib
import sys
import time

script_dir = pathlib.Path(sys.argv[1]).resolve()
if str(script_dir) not in sys.path:
    sys.path.insert(0, str(script_dir))
from agent_island_local_data import append_private_text, read_private_text, write_private_text

os.umask(0o077)

agent, surface, phase, title, message = sys.argv[2:7]
root = pathlib.Path.home() / ".agent-island"
events_path = root / "events.jsonl"

event = {
    "agent": agent,
    "surface": surface,
    "status": phase,
    "title": title,
    "message": message,
    "pid": os.getppid(),
    "ts": time.time(),
}

append_private_text(
    events_path,
    json.dumps(event, ensure_ascii=False, separators=(",", ":")) + "\n",
)

try:
    marker_path = root / "events-pruned-at"
    now = time.time()
    try:
        last_pruned_at = float(read_private_text(marker_path, maximum_bytes=128))
    except Exception:
        last_pruned_at = 0
    if events_path.stat().st_size < 1_000_000 and now - last_pruned_at < 60 * 60:
        print(events_path)
        raise SystemExit(0)
    retention_path = root / "data-retention.json"
    retention_days = 30
    try:
        retention = json.loads(read_private_text(retention_path, maximum_bytes=65_536))
        retention_days = {"7_days": 7, "30_days": 30, "90_days": 90}.get(
            str(retention.get("eventLog") or ""), 30
        )
    except Exception:
        pass
    cutoff = now - retention_days * 24 * 60 * 60
    retained = []
    for line in read_private_text(events_path).splitlines():
        try:
            if float(json.loads(line).get("ts") or 0) >= cutoff:
                retained.append(line)
        except Exception:
            pass
    write_private_text(events_path, ("\n".join(retained[-2000:]) + "\n") if retained else "")
    write_private_text(marker_path, str(now))
except Exception:
    pass

print(root / "events.jsonl")
PY
