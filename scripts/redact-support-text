"""Aggressively redact text before it leaves the local support boundary."""

from __future__ import annotations

import os
import re
import sys


def redact(value: str) -> str:
    home = os.path.expanduser("~")
    if home and home != "/":
        value = value.replace(home, "~")

    substitutions = (
        (r"(?i)(https?://)[^\s/@:]+:[^\s/@]+@", r"\1<credentials>@"),
        (r"(?i)\b(?:authorization\s*:\s*)?(bearer|basic)\s+[^\s,;]+", r"\1 <redacted>"),
        (
            r"(?i)\b(api[_-]?key|access[_-]?token|auth[_-]?token|refresh[_-]?token|"
            r"client[_-]?secret|password|passwd|secret|private[_-]?key)\b\s*[:=]\s*[^\s,;]+",
            r"\1=<redacted>",
        ),
        (
            r"(?i)--(?:api[_-]?key|access[_-]?token|auth[_-]?token|password|secret)"
            r"(?:=|\s+)\S+",
            "--<credential>=<redacted>",
        ),
        (r"\bgithub_pat_[A-Za-z0-9_]{16,}\b", "<redacted>"),
        (r"\bgh[pousr]_[A-Za-z0-9_]{16,}\b", "<redacted>"),
        (r"\bsk-[A-Za-z0-9_-]{16,}\b", "<redacted>"),
        (r"\bAIza[0-9A-Za-z_-]{20,}\b", "<redacted>"),
        (r"\bAKIA[0-9A-Z]{12,}\b", "<redacted>"),
        (r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b", "<redacted>"),
        (r"\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b", "<redacted>"),
        (r"\b[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}\b", "<session>"),
        (r"\b[0-9a-fA-F]{32,}\b", "<redacted-id>"),
        (r"(?i)\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", "<email>"),
        (r"(?:/Users/[^/\s:;,]+|~)/(?:[^\s:;,]+/?)*", "~/<redacted>"),
        (r"(?:/private)?/tmp/[^\s:;,]+", "/tmp/<redacted>"),
        (r"/dev/tty[^\s:;,]+", "/dev/tty<redacted>"),
    )
    for pattern, replacement in substitutions:
        value = re.sub(pattern, replacement, value)

    def redact_ip(match: re.Match[str]) -> str:
        address = match.group(0)
        if address.startswith("127.") or address == "0.0.0.0":
            return address
        return "<ip-address>"

    return re.sub(r"(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])", redact_ip, value)


def main() -> int:
    value = sys.stdin.read(2 * 1024 * 1024 + 1)
    if len(value) > 2 * 1024 * 1024:
        value = value[: 2 * 1024 * 1024] + "\n<support-output-truncated>\n"
    sys.stdout.write(redact(value))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
